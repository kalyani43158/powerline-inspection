# Copy to .env and fill what you need. Leave blank to use in-app alerts only.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
ALERT_EMAIL_TO=maintenance@example.com
# Telegram: create a bot with @BotFather, then:
# WEBHOOK_URL=https://api.telegram.org/bot<TOKEN>/sendMessage?chat_id=<CHAT_ID>
# Slack/Teams/Discord-style incoming webhooks also work if they accept {"text": "..."}
WEBHOOK_URL=
